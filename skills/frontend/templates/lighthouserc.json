{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": ["http://localhost:3000/admin/orders?view=today"],
      "settings": {
        "formFactor": "desktop",
        "screenEmulation": { "mobile": false, "width": 1280, "height": 800, "deviceScaleFactor": 1, "disabled": false },
        "throttling": { "rttMs": 150, "throughputKbps": 1638.4, "cpuSlowdownMultiplier": 4 }
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "pessimistic" }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 245760 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    }
  }
}
