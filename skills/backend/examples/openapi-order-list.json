      "WriteRequest": {
        "type": "object",
        "required": [
          "orderIds"
        ],
        "properties": {
          "orderIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{6,12}$"
            }
          }
        },
        "description": "本文は 16,384 バイトまで。Content-Length が負か上限を超えたら、本文を読まずに 400"
      },
      "WriteResult": {
        "type": "object",
        "required": [
          "orderId",
          "outcome",
          "code"
        ],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "shipped",
              "already_shipped",
              "not_shippable",
              "not_found",
              "cancelled",
              "already_cancelled",
              "not_allowed"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ORDER_ALREADY_SHIPPED",
              "ORDER_SHIP_PARTIAL",
              "ORDER_NOT_FOUND",
              "ORDER_CANCEL_NOT_ALLOWED",
              null
            ]
          },
          "reason": {
            "type": "string",
            "description": "出荷指示にできなかった行の今の状態（not_shippable のとき）。取り消した行は cancelled（取り消しの印から作る）"
          },
          "shippedBy": {
            "$ref": "#/components/schemas/UserRef"
          },
          "shippedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "cancelledAt": {
            "type": "string"
          }
        }
      },
      "WriteSummary": {
        "type": "object",
        "required": [
          "requested"
        ],
        "additionalProperties": {
          "type": "integer"
        },
        "properties": {
          "requested": {
            "type": "integer"
          }
        }
      },
      "ShipResponse": {
        "type": "object",
        "required": [
          "results",
          "summary"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WriteResult"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/WriteSummary"
          }
        }
      },
      "CancelResponse": {
        "type": "object",
        "required": [
          "results",
          "summary"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WriteResult"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/WriteSummary"
          }
        }
      }
    }
  }
